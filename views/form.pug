form(class='form' action="/pictures/upload" method="POST" enctype="multipart/form-data")

  div(class='form-group')
    input(type="file" name='image' accept="image/jpeg,image/png,image/webp" class="filestyle" data-placeholder="Aucun fichier" data-size="sm" data-buttonText="" data-buttonBefore="true")
  button(class="btn btn-sm btn-default" type="submit") Envoyer

  

  script(src='/javascripts/bootstrap-filestyle.js')